    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "TESTER_EMAIL@example.com",
        "subject": "=Generated Travel HTML Page - {{ $json.UpdatedAt }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 100%; width: 100%; box-sizing: border-box; overflow: visible;\">\n  {{ $('Prepare HTML Data').first().json.ReviewHtml }}\n</div>\n\n<hr style=\"margin: 28px 0; border: none; border-top: 1px solid #ddd;\">\n\n<p style=\"font-family: Arial, sans-serif; font-size: 15px; line-height: 1.6; text-align: center;\">\n  Please review the generated travel page preview above.\n  Then choose <strong>Approve</strong> or <strong>Reject</strong> below.\n  If you reject it, you may add an optional comment.\n</p>",
        "responseType": "customForm",
        "formFields": {
