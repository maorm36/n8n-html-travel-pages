    {
      "parameters": {
        "jsCode": "const originalData = $('Prepare HTML Data').first().json;\nconst response = $input.first().json;\n\nconst decision =\n  response.data?.decision ||\n  response.decision ||\n  response.data?.Decision ||\n  response.Decision ||\n  \"\";\n\nconst rawComment =\n  response.data?.reviewerComment ||\n  response.reviewerComment ||\n  response.data?.ReviewerComment ||\n  response.ReviewerComment ||\n  \"\";\n\nconst approved = decision.toString().toLowerCase() === \"approve\";\n\nconst reviewerComment = approved\n  ? \"\"\n  : rawComment.trim() || \"Rejected without comment\";\n\nreturn [\n  {\n    json: {\n      ...originalData,\n      Status: approved ? \"Approved\" : \"Rejected\",\n      Approved: approved,\n      ReviewerComment: reviewerComment,\n      UpdatedAt: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        0
      ],
      "id": "586292d6-7667-4908-a77d-a703c9ec1f6f",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const sheetRow = $('Get row(s) in sheet').first().json;\nconst groqOutput = $input.first().json;\n\nlet content = groqOutput.choices?.[0]?.message?.content || \"\";\n\ncontent = content\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/```$/i, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(content);\n} catch (error) {\n  parsed = {\n    generatedHtml: content,\n    reviewHtml: `\n      <div style=\"font-family:Arial,sans-serif;max-width:100%;width:100%;box-sizing:border-box;padding:20px;line-height:1.6;text-align:center;\">\n        <h2 style=\"margin:0 0 12px;\">Generated travel page</h2>\n        <p>The generated page was created, but the review preview could not be parsed.</p>\n        <p>Please check the GeneratedHtml field in Google Sheets or the GitHub backup file.</p>\n      </div>\n    `\n  };\n}\n\nreturn [\n  {\n    json: {\n      ...sheetRow,\n      GeneratedHtml: parsed.generatedHtml || \"\",\n      ReviewHtml: parsed.reviewHtml || \"\",\n      Status: \"Generated\",\n      UpdatedAt: new Date().toISOString()\n    }\n  }\n];"
      },
